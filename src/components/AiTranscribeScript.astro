<script>
  // Imported statically, so the page-load budget counts the island (its worker and model load with the first file).
  import { mountAi } from '../ui/ai';
  import { transcribeDef } from '../ui/transcribe';
  import { trackHooks } from '../ui/track';
  const el = document.querySelector<HTMLElement>('[data-kind="ai"][data-model="whisper"]');
  if (el) trackHooks(el.dataset.tool!, mountAi(el, transcribeDef()));
</script>
